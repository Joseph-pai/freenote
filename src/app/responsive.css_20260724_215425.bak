/* ── Responsive layout ── */
.mobile-only {
  display: none !important;
}
.desktop-only {
  display: flex !important;
}

@media (min-width: 768px) {
  .desktop-sidebar {
    display: flex !important;
  }
  .mobile-bottom-nav {
    display: none !important;
  }
  main {
    padding-bottom: 1.5rem !important;
  }
}

@media (max-width: 767px) {
  .desktop-sidebar {
    display: none !important;
  }
  .mobile-bottom-nav {
    display: flex !important;
  }
  main {
    padding-bottom: calc(72px + env(safe-area-inset-bottom)) !important;
  }
  .mobile-only {
    display: flex !important;
  }
  .desktop-only {
    display: none !important;
  }

  /* Split-pane layout toggles for mobile */
  .layout-container.show-detail .list-panel {
    display: none !important;
  }
  .layout-container.show-list .detail-panel {
    display: none !important;
  }
  .list-panel, .detail-panel {
    width: 100% !important;
    max-width: 100% !important;
    border-right: none !important;
  }
}

/* ── Container Queries for Main Workspace ── */
@container main-workspace (max-width: 600px) {
  /* Scale down fonts or grid when workspace is small */
  .calendar-day-number {
    width: 22px !important;
    height: 22px !important;
    font-size: 0.75rem !important;
  }
  .calendar-event {
    font-size: 0.6rem !important;
    padding: 1px 3px !important;
  }
}

@container main-workspace (max-width: 400px) {
  .calendar-day-cell {
    min-height: 60px !important;
  }
}
